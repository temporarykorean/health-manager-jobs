\n\t\t\t$(\"#e_date\").next(\"img\").attr('alt', '등록일 종료일 달력').attr('title', '등록일 종료일 달력');\r\n\t\t});\r\n\t\r\n\t\t\r\n\t\t$(function() {\r\n\t\t\t$('input[name=eduType]').click(function(e){\r\n\t\t\t\tvar chkVal = e.target.value;\r\n\t\t\t\tvar chkYN = e.target.checked;\r\n\t\t\t\t\r\n\t\t\t\t$('input[name=eduType]').prop(\"checked\", false);\r\n\t\t\t\tif(chkYN == true){\r\n\t\t\t\t\t$('input#'+chkVal).prop(\"checked\", true);\r\n\t\t\t\t}\r\n\t\t\t})\r\n\t\t});\r\n\t\t\r\n\t//init\r\n\t\t$(document).ready(function() {\r\n\t\t\tvar obj =\"\";\r\n\t\t\t$(\"#jobDetailDiv\").hide();\r\n\t\t\t$(\"#detailCon\").hide();\r\n\t\t\t$(\"#testCD\").children().change(function(){\r\n\t\t\t\t$(\"#jobResult\").html(\"&nbsp\");\r\n\t\t\t\t$(\"input[name='detail_code']:checked\").each(function() { \r\n\t\t\t\t\t$(\"#jobResult\").append($(\"#\"+this.value).html()+\", \");\r\n\t\t\t\t})\r\n\t\t\t});\r\n\t\t\t\r\n\t\t\t$('#org_name').select2({\r\n\t  \t\t\tdata: data\r\n\t  \t\t\t,width: \"280px\"\r\n\t  \t\t});\r\n\t\t\t\r\n\t\t\t$('#org_name').css(\"margin-left\",\"10px\");\r\n\t\t\t\r\n\t\t\tvar hiddenParam = $('#hidden_org_name').attr('data-value');\r\n\t\t\tif(hiddenParam){\r\n\t\t\t\t$('#org_name').val(hiddenParam).trigger('change.select2');\r\n\t\t\t}\r\n\t\t\t\r\n\t\t});\r\n\t\r\n\t\t//직종보기\r\n\t\tfunction jobDetail(){\r\n\t\t\t\t$( \"#jobDetailDiv\" ).slideToggle( \"middle\" );\r\n\t\t}\r\n\t\tfunction jobDetailOpen(){\r\n\t\t\t\t$(\"#detailOpenImg\").html(\"<a href='#' onclick='jobDetailClose()'><img src='/images/content/btn_searchClose.gif' alt='상세검색 닫기' />\");\r\n\t\t\t\t$(\"#jobDetailDiv\").slideDown();\r\n\t\t\t\t$( \"#detailCon\" ).slideDown( \"slow\" );\r\n\t\t}\r\n\t\tfunction jobDetailClose(){\r\n\t\t\t\t$(\"#detailOpenImg\").html(\"<a href='#' onclick='jobDetailOpen()'><img src='/images/content/btn_searchOpen.gif' alt='상세검색 열기' /></a>\");\r\n\t\t\t\t$(\"#jobDetailDiv\").slideUp();\r\n\t\t\t\t$( \"#detailCon\" ).slideUp( \"fast\" );\r\n\t\t}\r\n\t\t\r\n\t\tvar Tmen