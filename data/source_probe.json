put[name=\"detail_code\"]:checked').size() > 0) {\r\n\t\t\t$(\"#jobResult\").html(\"&nbsp\");\r\n\t\t\t$(\"input[name='detail_code']:checked\").each(function(index) { \r\n\r\n\t\t\t\tvar chk = $(\"input[name='detail_code']:checked\").length-1;\r\n\t\t\t\t\r\n\t\t\t\tif(index != chk){\r\n\t\t\t\t\t$(\"#jobResult\").append($(\"#\"+this.value).html()+\", \");\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$(\"#jobResult\").append($(\"#\"+this.value).html());\r\n\t\t\t\t}\r\n\t\t\t})\r\n\t\t}\r\n\t}\r\n\t\r\n\t//상세정보 우클릭 새창위한 함수\r\n\tfunction onRightClick(idx){\r\n\t\t$('#view_'+idx).attr('href','/recruitview.do?idx='+idx);\r\n\t}\r\n\t\r\n\t//csv 다운로드\r\n\tfunction goExcelCsv(){\r\n\t\t$('.wrap-loading').removeClass('display-none');\r\n\t\t$.fileDownload(\"/getCSVRecruitList.do\", {\r\n\t\t\tdata : {'fileName' : '채용정보목록'},\t\r\n\t\t\thttpMethod : \"POST\",\r\n//\t\t\tpreparingMessageHtml : \"통계자료를 만들고 있습니다.<br/>잠시만 기다려 주세요.\",\r\n//\t\t\tfailMessageHtml: \"자료 다운로드 실패입니다.<br/>잠시 후 다시 시도해 주세요.\",\r\n\t\t\tsuccessCallback : function (url){     \r\n\t\t\t\t$('.wrap-loading').addClass('display-none');\r\n\t        },      \r\n\t        failCallback: function (html, url){    \r\n\t            alert(\"자료 다운로드 실패입니다. 잠시 후 다시 시도해 주세요.\");\r\n\t            $('.wrap-loading').addClass('display-none');\r\n\t        }\r\n\t\t});\r\n\t\t\r\n\t}\r\n\t\r\n\tfunction fnEnterEvent(e, fn){\r\n\t\tif(e.keyCode == 13){\r\n\t\t\teval(fn);\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\telse{\r\n\t\t\treturn true;\r\n\t\t}\r\n\t}\r\n\t</script>\r\n\r\n\r\n\r\n<div id=\"container01\">\r\n\t<!-- 콘텐츠 시작 -->\r\n\t<div id=\"content\">\r\n\t\t<h3>공공기관 채용정보</h3>\r\n\r\n\t\t<div id=\"txt\">\r\n\t\t\t<!-- 상세검색 열기 전 시작 -->\r\n\t\t\t\r\n\t\t\t<script type=\"text/javascript\">\r\n\t\t\t\t\tfunction fn_reset() {\r\n\t\t\t\t\t\t$('#searchRecruitYear').val('');\r\n\t\t\t\t\t\t$('#searchRecruitMonth').val('');\r\n\t\t\t\t\t\t$('#jobResult').html(\"&nbsp;\");\r\n\t\t\t\t\t\t$('#jobResult').addClass('bg_inp01');\r\n\t\t\t\t\t\t$('#jo