      } \r\n\t         },complete:function(){ \r\n\t         // 이동을 마친후 첫번째 a태그를 지워버린다 \r\n\t         $(this).remove(); \r\n\t     \t // 롤링마지막에 맨처음의 a태그 추가 \r\n\t         $(\".f_banner > div\").append(\"<a href=\\\"\"+$(\".f_banner > div > a:first\").attr(\"href\")+ \"\\\" target=\\\"_blank\\\">\" + $(\".f_banner > div > a:first\").html()+ \"</a>\");\r\n\t         // 이미지 움직이는것을 다시 실행 \r\n\t         imgMove(); \r\n\t      }}); \r\n\t      }else{ \r\n\t      // 마지막 a태그의 폭 \r\n\t       var aWidth = $(\".f_banner > div > a:last\").width(); \r\n\t       // 맨처음 a태그의 margin-left를 다시 0으로 맞춰준다. \r\n\t      $(\".f_banner > div > a:first\").animate({marginLeft:0},{duration:moveSpeed,step:function(){ \r\n\t       // 이동중 만약 일시정지 flag가 true라면 \r\n\t       if(movePause==true){ \r\n\t          // 이동을 멈춘다 \r\n\t          $(this).stop(true, false); \r\n\t       } \r\n\t       },complete:function(){ \r\n\t       // 이동을 마친후 마지막 a태그를 지워버린다 \r\n\t       $(\".f_banner > div > a:last\").remove();\r\n\t    // a태그 앞에 마지막의 a태그를 생성한다 단 스타일은 마지막 a태그의 폭만큼 빼준다 \r\n\t       $(\"<a href=\\\"\" + $(\".f_banner > div > a:last\").attr(\"href\")+ \"\\\" style=\\\"margin-left:-\" + aWidth + \"px\\\">\" + $(\".f_banner > div > a:last\").html()+ \"</a>\").insertBefore(\".f_banner > div > a:first\")\r\n\t       // 이미지 움직이는것을 다시 실행 \r\n\t       imgMove(); \r\n\t    }}); \r\n\t } \r\n\t } \r\n\t } \r\n\t function goMove(){ \r\n\t    // 일시정지가 풀려있을 경우를 대비하여 일시정지를 풀러준다 \r\n\t    movePause=false; \r\n\t    // 0d\\일경우 left방향 \r\n\t    if(moveType==0){ \r\n\t       imgMove(); \r\n\t       }else{ \r\n\t       $(\".f_banner > div > a:first\").animate({marginLeft:0},{duration:moveSpeed,step:function(){ \r\n\t       // 이동중 만약 일시정지 flag가 true라면 \r\n\t       \tif(movePause==true){ \r\n\t          // 이동을 멈춘다 \r\n\t          $(this).stop(true, false); \r\n\t      \t} \r\n\t       },complete:function(){ \r\n\t      // 이동을 마친후 마지막 a태그를 지워버린다 \r\n\t      $(\".f_banner > div > a:last\").remove(); \r\n\t      // 이미지 움직이는것을 다시 실행 \r\n\t      imgMove(); \r\n\t   }});  \r\n\t } \r\n\t   \r\n\t}\r\n\t \r\n\t\r\n\t \r\n</script>\r\n\r\n\t<div id=\"footer_wrap\">\r\n\t\r\n\t\t<!-- <div class=\"nav_banner\">\r\n\t\t\t<button onClick=\"moveType=0;\">왼쪽으로</button>  \r\n\t\t\t<button onClick=\"moveType=1;\">오른쪽으로</button>  \r\n\t\t\t<button onClick=\"movePause=true;\">일시정지</button>  \r\n\t\t\t<button onClick=\"goMove();\">움직이기</button>  \r\n\t\t</div> -->\r\n\t\r\n\t\t<div class=\"f_banner\">\r\n\t\t\t<!-- <ul>\r\n\t\t\t\t<li><a href=\"http://www.work.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner01.gif\" alt=\"WORKNET\" /></a></li>\r\n\t\t\t\t<li><a href=\"http://www.gojobs.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner02.gif\" alt=\"나라일터\" /></a></li>\r\n\t\t\t\t<li><a href=\"http://matchingbank.career.co.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner03.gif\" alt=\"대체인력뱅크\" /></a></li>\r\n\t\t\t\t<li><a href=\"http://www.moel.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner04.gif\" alt=\"고용노동부\" /></a></li>\r\n\t\t\t\t<li><a href=\"http://www.worktogether.or.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner05.gif\" alt=\"WORK TOGETHER\" /></a></li>\r\n\t\t\t</ul> -->\r\n\t\t\t<div onmouseover=\"movePause=true;\" onmouseout=\"goMove();\">\t\t\t\r\n\t\t\t\t<a href=\"https://www.work24.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner01.gif\" alt=\"WORKNET\" /></a>\r\n\t\t\t\t<a href=\"https://www.hrdb.go.kr/OpenRecommend\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/banner_2018.jpg\" alt=\"국민추천제\" /></a>\r\n\t\t\t\t<a href=\"https://www.gojobs.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner02.gif\" alt=\"나라일터\" /></a>\r\n\t\t\t\t<a href=\"https://matchingbank.career.co.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner03.gif\" alt=\"인재채움뱅크\" /></a>\r\n\t\t\t\t<a href=\"https://www.moel.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner04.gif\" alt=\"고용노동부\" /></a>\r\n\t\t\t\t<a href=\"https://www.youthcenter.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner07.jpg\" alt=\"청년워크넷 온라인청년센터\" /></a>\r\n\t\t\t\t<a href=\"https://www.alioplus.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner08.jpg\" alt=\"알리오플러스\" /></a>\r\n\t\t\t\t<a href=\"https://www.alio.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner09.gif\" alt=\"알리오포털\" /></a>\r\n\t\t\t\t<a href=\"https://opendata.alio.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner12.jpg\" alt=\"청년일자리\" /></a>\r\n\t\t\t\t<!-- 접속 불가 사이트 -->\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t</div>\r\n\t\t\t\r\n\t\t</div>\r\n\t\t<div id=\"footer\">\r\n\t\t\t<strong class=\"dis_hide\">하단 이용메뉴</strong>\r\n\t\t\t<ul id=\"bt_menu\">\r\n\t\t\t\t\r\n\t\t\t\t<li><a href=\"/right.do\">저작권정책</a></li>\r\n\t\t\t\t<li><a href=\"/noemail.do\">이메일무단수집거부</a></li>\r\n\t\t\t\t<li class=\"end\"><a href=\"/privacy.do\">개인정보처리방침</a></li>\r\n\t\t\t</ul>\r\n\t\t\t<p class=\"logo\"><img src=\"/images/common/img_f_logo.gif\" alt=\"재정경제부\" /></p>\r\n\t\t\t<address>(우)30112 세종특별자치시 도움6로 42 정부세종청사 재정경제부 <br />\r\n\t\t\tCopyright © 2011 Ministry of Finance and Economy. Republic of Korea. Some Right Reserved.</address>\r\n\t\t</div>\r\n\t</div>\r\n\t\r\n</div>\t\r\n\t\r\n\t<form method=\"post\" name=\"pfileForm\" id=\"pfileForm\" target=\"_blank\"> \r\n\t\t<input type=\"hidden\" name=\"spath\" id=\"spath\"  value=\"\" />\r\n\t\t<input type=\"hidden\" name=\"sfile\" id=\"sfile\"  value=\"\" />\r\n\t\t<input type=\"hidden\" name=\"dfile\" id=\"dfile\"  value=\"\" />\r\n\t</form>\t\r\n\t\r\n\t<iframe id=\"dialogs\" name=\"dialogs\" title=\"데이터제출용\" style=\"display:none;\"></iframe>\r\n\t<iframe id=\"goExcel\" name=\"goExcel\" title=\"데이터제출용\" style=\"display:none;\"></iframe>\r\n\t\r\n<script type=\"text/javascript\">\r\n\tfunction notice() {\r\n\t\talert(\"기존 회원정보 이관 작업 중 입니다.\\n곧 서비스될 예정이오니 양해바랍니다.\t\");\r\n\t}\r\n</script>\t\t\r\n\t\r\n\t<div class=\"wrap-loading display-none\" style=\"z-index: 1000000;\">\r\n\t<div>\r\n\t\t<img src=\"/images/common/ajax_loader.gif\" alt=\"로딩이미지\" />\r\n\t</div>\r\n</div>\r\n</body>\r\n</html>\r\n"}, "https://job.alio.go.kr/right.do": {"url": "https://job.alio.go.kr/right.do", "text": "\r\n\r\n\r\n<!DOCTYPE html>\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"ko\">\r\n<head>\r\n<title>공공기관 채용정보시스템</title>\r\n<meta charset=\"UTF-8\" />\r\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\">\r\n\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/css/css.css\" media=\"all\" />\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/css/jquery.ui.datepicker.css\" />\t\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/css/lib/select2.min.css\" />\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/css/swiper/swiper.min.css\" />\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/css/swiper/swiper2.min.css\" />\r\n\r\n    <script type=\"text/javascript\" src=\"/js/js.js\"></script>\r\n\r\n\r\n\t<script type=\"text/javascript\" src=\"/js/lib/jquery-1.11.1.min.js\"></script>\r\n\t<script type=\"text/javascript\" src=\"/js/lib/jquery-ui-1.10.3.min.js\"></script>\r\n\t<script type=\"text/javascript\" src=\"/js/lib/jquery.blockUI.js\"></script>\t\t\r\n\t<script type=\"text/javascript\" src=\"/js/lib/jquery.ui.datepicker.js\"></script>\r\n\t<script type=\"text/javascript\" src=\"/js/lib/select2.full.js\"></script>\r\n\r\n\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n</head>\r\n<body>\r\n\r\n\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\t\t\t\r\n/* \tvar Tmenu_2deps_display = \"N\";//2차메뉴 숨김여부(Y,N)\r\n\tvar Tmenu_code = \"\";//메뉴코드KO_02_01_01\r\n\tvar Tmenu_width = \"N\";//1차메뉴 자동크기\r\n\tvar Tmenu_left = [\r\n\t\t\"220\",\t//01 하위메뉴\r\n\t\t\"180\",\t//02 하위메뉴\r\n\t\t\"280\",\t//03 하위메뉴\r\n\t\t\"180\",\t//04 하위메뉴\r\n\t];\r\n\tTmenu_setting(Tmenu_2deps_display,Tmenu_code,Tmenu_width,Tmenu_left);//실행\t\t */\r\n\t\r\n/* \t */\r\n\t//접속한기기가 iPhone, iPod, Windows CE, Symbian, BlackBerry, Android일 경우에는 mobile2.jsp로 연결된다.\r\n\t\r\n\t\r\n\t\r\n\tfunction mobileCheck() {\r\n\t\t\r\n\t\tif(\"\" == \"sesstionPC\"){\r\n\t\t\t\r\n\t\t}else if(navigator.userAgent.match(/iPhone/i)\r\n\t\t\t||navigator.userAgent.match(/iPod/i)\r\n\t\t\t||navigator.userAgent.match(/Windows CE/i)\r\n\t\t\t||navigator.userAgent.match(/Symbian/i)\r\n\t\t\t||navigator.userAgent.match(/BlackBerry/i)\r\n\t\t\t||navigator.userAgent.match(/Android/i)\r\n\t\t) {\r\n\t\t\t//alert(\"현재접속한 브라우저는  :\"+navigator.userAgent); \t\t\r\n\t\t\twindow.location.href=\"/mobile2021/home.do\";\r\n\t\t} \r\n\t}\r\n\tmobileCheck();\r\n/* \t */\r\n</script>\r\n\r\n\r\n\r\n\r\n<h3 class=\"dis_hide\">건너뛰기영역</h3>\r\n\t<a href=\"#content\" class=\"skip\">본문바로가기</a>\r\n\r\n<div id=\"wrap\">\t\t\t\t\t\t\r\n\t<div class=\"gnb_bg\"></div>\r\n\t<div id=\"header_wrap\">\r\n\t\t<h1 class=\"eg\">이 누리집은 대한민국 공식 전자정부 누리집입니다.</h1>\r\n\t\t<div id=\"header\">\r\n\t\t\t<h1>\r\n\t\t\t\t<a href=\"/home.do\"><img src=\"/images/common/img_t_logo.gif\" alt=\"JOB-ALIO 공공기관 채용정보시스템\" /></a>\r\n\t\t\t</h1>\r\n\t\t\t<div id=\"etc\">\r\n\t\t\t\t<ul>\r\n\r\n\t\t\t\t\t\r\n\t\t\t\t\t<li><a href=\"/login.do\">로그인</a></li>\r\n\t\t\t\t\t\r\n\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\t<li class=\"etc_end\"><a href=\"/sitemap.do\">전체메뉴</a></li>\r\n\t\t\t\t</ul>\r\n\t\t\t</div>\r\n\r\n\t\t\t<h2 class=\"dis_hide\">홈페이지 주메뉴</h2>\r\n\t\t\t<div id=\"gnb\">\r\n\t\t\t\t<ul>\r\n\t\t\t\t\t<li><a href=\"/recruit.do\"><img\r\n\t\t\t\t\t\t\tsrc=\"/images/common/gnb/gnb_01.gif\" alt=\"공공기관 채용정보\" /></a>\r\n\t\t\t\t\t\t\t<ul class=\"menu01\">\r\n\t\t\t\t\t\t\t\t<li><a href=\"/recruit.do\">공공기관 채용정보</a></li>\r\n\t\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t\t<li><a href=\"/information.do\"><img src=\"/images/common/gnb/gnb_02.gif\" alt=\"공공기관 정보\" /></a>\r\n\t\t\t\t\t\t<ul class=\"menu02\">\r\n\t\t\t\t\t\t\t<li><a href=\"/information.do\">공공기관이란</a></li>\r\n\t\t\t\t\t\t\t<li><a href=\"/orginfo.do\">공공기관정보</a></li>\r\n\t\t\t\t\t\t\t<li><a href=\"/orgcompare.do\">공공기관비교</a></li>\r\n\t\t\t\t\t\t</ul></li>\r\n\t\t\t\t\t\r\n\t\t\t\t\t<li><a href=\"http://www.publicjob.kr\" target=\"_blank\"><img\r\n\t\t\t\t\t\t\tsrc=\"/images/common/gnb/gnb_03.gif\" alt=\"공공기관 채용정보박람회\" /></a>\r\n\t\t\t\t\t\t<ul class=\"menu03\">\r\n\t\t\t\t\t\t\t<li><a href=\"http://www.publicjob.kr\" target=\"_blank\">공공기관 채용정보박람회</a></li>\r\n\t\t\t\t\t\t\t<li></li>\r\n\t\t\t\t\t\t\t<li></li>\r\n\t\t\t\t\t\t\t<li></li>\r\n\t\t\t\t\t\t\t<li></li>\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t<!-- <li><a href=\"/schedule.do\">전체일정표</a></li>\r\n\t\t\t\t\t\t\t<li><a href=\"/map.do\">오시는 길</a></li> -->\r\n\t\t\t\t\t\t</ul></li>\r\n\t\t\t\t\t<li><a href=\"/introduce.do\"><img\r\n\t\t\t\t\t\t\tsrc=\"/images/common/gnb/gnb_04.gif\" alt=\"JOB-ALIO 소개\" /></a>\r\n\t\t\t\t\t\t<ul class=\"menu04\">\r\n\t\t\t\t\t\t\t<li><a href=\"/introduce.do\">JOB-ALIO 소개</a></li>\r\n\t\t\t\t\t\t\t<li><a href=\"/notice.do\">공지사항</a></li>\r\n\t\t\t\t\t\t</ul></li>\r\n\t\t\t\t</ul>\r\n\t\t\t</div>\r\n\t\t\r\n\t</div>\r\n\t</div>\r\n\t\t\t\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\t\r\n\t\r\n\r\n<script type=\"text/javascript\">\t\t\t\r\n\tvar Tmenu_2deps_display = \"N\";//2차메뉴 숨김여부(Y,N)\r\n\tvar Tmenu_code = \"\";//메뉴코드KO_02_01_01\r\n\tvar Tmenu_width = \"N\";//1차메뉴 자동크기\r\n\tvar Tmenu_left = [\r\n\t\t\"220\",\t//01 하위메뉴\r\n\t\t\"180\",\t//02 하위메뉴\r\n\t\t\"280\",\t//03 하위메뉴\r\n\t\t\"180\",\t//04 하위메뉴\r\n\t];\r\n\tTmenu_setting(Tmenu_2deps_display,Tmenu_code,Tmenu_width,Tmenu_left);//실행\t\t\t\r\n</script>\r\n\r\n\t\r\n\r\n\t\r\n\t<div id=\"container02\">\r\n\t<!-- 콘텐츠 시작 -->\t\r\n\t\t<div id=\"content\">\r\n\t\t\t<h3>저작권 정책 안내</h3>\r\n\t\t\t\r\n\t\t\t<div id=\"txt\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<ul class=\"h6 icon_03\">\r\n\t\t\t\t\t<li>저작권법 제24조의2(공공저작물의 자유이용)에 따라 잡알리오 홈페이지에서 제공하는 자료 중에서 잡알리오가 저작재산권의 전부를 보유한 저작물의 경우에는 별도의 이용허락 없이 자유이용이 가능합니다.</li>\r\n\t\t\t\t\t<li style=\"letter-spacing: 0.5px;\">공공데이터법 제1조, 제3조에 근거하여 잡알리오 홈페이지에서 제공하는 공공데이터는 누구나 이용가능하고, 영리 목적의 이용을 포함한 자유로운 활용이 보장됩니다.</li>\r\n\t\t\t\t\t<li>단, 정보공개법 제9조의 비공개대상정보와 저작권법 및 그 밖의 다른 법령에서 보호하고 있는 제3자의 권리가 포함된 것으로 해당 법령에 따른 정당한 이용허락을 받지 아니한 정보는 제공 대상에서 제외됩니다.(공공데이터법 제17조)</li>\r\n\t\t\t\t</ul>\r\n\t\t\t\t\r\n\t\t\t\t<div style=\"text-align: center;\">\r\n\t\t\t\t\t<a class=\"btn type_03\" href=\"http://www.law.go.kr/lsInfoP.do?lsiSeq=162150&ancYd=20141119&efYd=20141119&ancNo=12844\" title=\"국가법령정보센터 공공데이터법 새 창 열림\" target=\"_blank\"><span class=\"text\">국가법령정보센터 공공데이터법</span></a>&nbsp;&nbsp;\r\n\t\t\t\t\t<a class=\"btn type_03\" href=\"http://www.law.go.kr/lsSc.do?menuId=0&p1=&subMenu=1&query=%EC%A0%80%EC%9E%91%EA%B6%8C%EB%B2%95&x=0&y=0#liBgcolor0\" title=\"국가법령정보센터 저작권법 새 창 열림\" target=\"_blank\"><span class=\"text\">국가법령정보센터 저작권법</span></a>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t\t\r\n\t</div>\r\n\r\n\r\n\r\n\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\r\n\r\n$(document).ready(function () {\r\n\timgMove();\t\r\n});\r\n\r\n\t//moveType (0:left / 1:right) \r\n\tvar moveType = 0; \r\n\t// 이동시간간격 3초 \r\n\tvar moveSpeed = 3000; \r\n\t// 움직이는 작업중 다시 명령 받지 않음 \r\n\tvar moveWork = false; \r\n\t// 일시정지 flag \r\n\tvar movePause = false; \r\n\tfunction imgMove(){ \r\n\t\t\r\n\t    if(moveWork==false){ \r\n\t       // 0d\\일경우 left방향 \r\n\t      if(moveType==0){ \r\n\t         // 맨처음 이미지의 폭 \r\n\t         var aWidth = $(\".f_banner > div > a:first\").width(); \r\n\t         \r\n\t          \r\n\t         // 맨처음이미지를 왼쪽으로 이동시킨다. \r\n\t         $(\".f_banner > div > a:first\").animate({marginLeft:-aWidth},{duration:moveSpeed,step:function(){ \r\n\t         // 이동중 만약 일시정지 flag가 true라면 \r\n\t         if(movePause==true){ \r\n\t            // 이동을 멈춘다 \r\n\t            $(this).stop(true, false); \r\n\t         } \r\n\t         },complete:function(){ \r\n\t         // 이동을 마친후 첫번째 a태그를 지워버린다 \r\n\t         $(this).remove(); \r\n\t     \t // 롤링마지막에 맨처음의 a태그 추가 \r\n\t         $(\".f_banner > div\").append(\"<a href=\\\"\"+$(\".f_banner > div > a:first\").attr(\"href\")+ \"\\\" target=\\\"_blank\\\">\" + $(\".f_banner > div > a:first\").html()+ \"</a>\");\r\n\t         // 이미지 움직이는것을 다시 실행 \r\n\t         imgMove(); \r\n\t      }}); \r\n\t      }else{ \r\n\t      // 마지막 a태그의 폭 \r\n\t       var aWidth = $(\".f_banner > div > a:last\").width(); \r\n\t       // 맨처음 a태그의 margin-left를 다시 0으로 맞춰준다. \r\n\t      $(\".f_banner > div > a:first\").animate({marginLeft:0},{duration:moveSpeed,step:function(){ \r\n\t       // 이동중 만약 일시정지 flag가 true라면 \r\n\t       if(movePause==true){ \r\n\t          // 이동을 멈춘다 \r\n\t          $(this).stop(true, false); \r\n\t       } \r\n\t       },complete:function(){ \r\n\t       // 이동을 마친후 마지막 a태그를 지워버린다 \r\n\t       $(\".f_banner > div > a:last\").remove();\r\n\t    // a태그 앞에 마지막의 a태그를 생성한다 단 스타일은 마지막 a태그의 폭만큼 빼준다 \r\n\t       $(\"<a href=\\\"\" + $(\".f_banner > div > a:last\").attr(\"href\")+ \"\\\" style=\\\"margin-left:-\" + aWidth + \"px\\\">\" + $(\".f_banner > div > a:last\").html()+ \"</a>\").insertBefore(\".f_banner > div > a:first\")\r\n\t       // 이미지 움직이는것을 다시 실행 \r\n\t       imgMove(); \r\n\t    }}); \r\n\t } \r\n\t } \r\n\t } \r\n\t function goMove(){ \r\n\t    // 일시정지가 풀려있을 경우를 대비하여 일시정지를 풀러준다 \r\n\t    movePause=false; \r\n\t    // 0d\\일경우 left방향 \r\n\t    if(moveType==0){ \r\n\t       imgMove(); \r\n\t       }else{ \r\n\t       $(\".f_banner > div > a:first\").animate({marginLeft:0},{duration:moveSpeed,step:function(){ \r\n\t       // 이동중 만약 일시정지 flag가 true라면 \r\n\t       \tif(movePause==true){ \r\n\t          // 이동을 멈춘다 \r\n\t          $(this).stop(true, false); \r\n\t      \t} \r\n\t       },complete:function(){ \r\n\t      // 이동을 마친후 마지막 a태그를 지워버린다 \r\n\t      $(\".f_banner > div > a:last\").remove(); \r\n\t      // 이미지 움직이는것을 다시 실행 \r\n\t      imgMove(); \r\n\t   }});  \r\n\t } \r\n\t   \r\n\t}\r\n\t \r\n\t\r\n\t \r\n</script>\r\n\r\n\t<div id=\"footer_wrap\">\r\n\t\r\n\t\t<!-- <div class=\"nav_banner\">\r\n\t\t\t<button onClick=\"moveType=0;\">왼쪽으로</button>  \r\n\t\t\t<button onClick=\"moveType=1;\">오른쪽으로</button>  \r\n\t\t\t<button onClick=\"movePause=true;\">일시정지</button>  \r\n\t\t\t<button onClick=\"goMove();\">움직이기</button>  \r\n\t\t</div> -->\r\n\t\r\n\t\t<div class=\"f_banner\">\r\n\t\t\t<!-- <ul>\r\n\t\t\t\t<li><a href=\"http://www.work.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner01.gif\" alt=\"WORKNET\" /></a></li>\r\n\t\t\t\t<li><a href=\"http://www.gojobs.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner02.gif\" alt=\"나라일터\" /></a></li>\r\n\t\t\t\t<li><a href=\"http://matchingbank.career.co.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner03.gif\" alt=\"대체인력뱅크\" /></a></li>\r\n\t\t\t\t<li><a href=\"http://www.moel.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner04.gif\" alt=\"고용노동부\" /></a></li>\r\n\t\t\t\t<li><a href=\"http://www.worktogether.or.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner05.gif\" alt=\"WORK TOGETHER\" /></a></li>\r\n\t\t\t</ul> -->\r\n\t\t\t<div onmouseover=\"movePause=true;\" onmouseout=\"goMove();\">\t\t\t\r\n\t\t\t\t<a href=\"https://www.work24.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner01.gif\" alt=\"WORKNET\" /></a>\r\n\t\t\t\t<a href=\"https://www.hrdb.go.kr/OpenRecommend\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/banner_2018.jpg\" alt=\"국민추천제\" /></a>\r\n\t\t\t\t<a href=\"https://www.gojobs.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner02.gif\" alt=\"나라일터\" /></a>\r\n\t\t\t\t<a href=\"https://matchingbank.career.co.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner03.gif\" alt=\"인재채움뱅크\" /></a>\r\n\t\t\t\t<a href=\"https://www.moel.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner04.gif\" alt=\"고용노동부\" /></a>\r\n\t\t\t\t<a href=\"https://www.youthcenter.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner07.jpg\" alt=\"청년워크넷 온라인청년센터\" /></a>\r\n\t\t\t\t<a href=\"https://www.alioplus.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner08.jpg\" alt=\"알리오플러스\" /></a>\r\n\t\t\t\t<a href=\"https://www.alio.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner09.gif\" alt=\"알리오포털\" /></a>\r\n\t\t\t\t<a href=\"https://opendata.alio.go.kr\" target=\"_blank\" title=\"새창\"><img src=\"/images/common/btn_f_banner12.jpg\" alt=\"청년일자리\" /></a>\r\n\t\t\t\t<!-- 접속 불가 사이트 -->\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t</div>\r\n\t\t\t\r\n\t\t</div>\r\n\t\t<div id=\"footer\">\r\n\t\t\t<strong class=\"dis_hide\">하단 이용메뉴</strong>\r\n\t\t\t<ul id=\"bt_menu\">\r\n\t\t\t\t\r\n\t\t\t\t<li><a href=\"/right.do\">저작권정책</a></li>\r\n\t\t\t\t<li><a href=\"/noemail.do\">이메일무단수집거부</a></li>\r\n\t\t\t\t<li class=\"end\"><a href=\"/privacy.do\">개인정보처리방침</a></li>\r\n\t\t\t</ul>\r\n\t\t\t<p class=\"logo\"><img src=\"/images/common/img_f_logo.gif\" alt=\"재정경제부\" /></p>\r\n\t\t\t<address>(우)30112 세종특별자치시 도움6로 42 정부세종청사 재정경제부 <br />\r\n\t\t\tCopyright © 2011 Ministry of Finance and Economy. Republic of Korea. Some Right Reserved.</address>\r\n\t\t</div>\r\n\t</div>\r\n\t\r\n</div>\t\r\n\t\r\n\t<form method=\"post\" name=\"pfileForm\" id=\"pfileForm\" target=\"_blank\"> \r\n\t\t<input type=\"hidden\" name=\"spath\" id=\"spath\"  value=\"\" />\r\n\t\t<input type=\"hidden\" name=\"sfile\" id=\"sfile\"  value=\"\" />\r\n\t\t<input type=\"hidden\" name=\"dfile\" id=\"dfile\"  value=\"\" />\r\n\t</form>\t\r\n\t\r\n\t<iframe id=\"dialogs\" name=\"dialogs\" title=\"데이터제출용\" style=\"display:none;\"></iframe>\r\n\t<iframe id=\"goExcel\" name=\"goExcel\" title=\"데이터제출용\" style=\"display:none;\"></iframe>\r\n\t\r\n<script type=\"text/javascript\">\r\n\tfunction notice() {\r\n\t\talert(\"기존 회원정보 이관 작업 중 입니다.\\n곧 서비스될 예정이오니 양해바랍니다.\t\");\r\n\t}\r\n</script>\t\t\r\n\t\r\n\t<div class=\"wrap-loading display-none\" style=\"z-index: 1000000;\">\r\n\t<div>\r\n\t\t<img src=\"/images/common/ajax_loader.gif\" alt=\"로딩이미지\" />\r\n\t</div>\r\n</div>\r\n</body>\r\n</html>\r\n"}, "https://careers.hybecorp.com/ko/o/234375": {"url": "https://careers.hybecorp.com/ko/o/234375", "text": "<!DOCTYPE html><html lang=\"ko\" data-dpl-id=\"09febce9344d96b0d2b83c5544a44784880b1b1d\"><head><meta charSet=\"utf-8\" data-next-head=\"\"/><meta name=\"viewport\" content=\"width=device-width\" data-next-head=\"\"/><script async=\"\" src=\"https://www.googletagmanager.com/gtag/js?id=추적 ID 넣는 공간\" data-next-head=\"\"></script><link href=\"/cdn-cgi/image/width=48,height=48,fit=cover,format=png/https://profiles.greetinghr.com/group/2af31013-cc31-46d5-be02-53d5c5589149\" rel=\"icon\" type=\"image/png\" data-next-head=\"\"/><link href=\"/cdn-cgi/image/width=48,height=48,fit=cover,format=png/https://profiles.greetinghr.com/group/2af31013-cc31-46d5-be02-53d5c5589149\" rel=\"apple-touch-icon\" sizes=\"48x48\" data-next-head=\"\"/><meta content=\"notranslate\" name=\"googlebot\" data-next-head=\"\"/><link href=\"https://careers.hybecorp.com/ko/o/234375\" rel=\"canonical\" data-next-head=\"\"/><link href=\"https://careers.hybecorp.com/ko/o/234375\" hrefLang=\"ko\" rel=\"alternate\" data-next-head=\"\"/><link href=\"https://careers.hybecorp.com/ko/o/234375\" hrefLang=\"ko-kr\" rel=\"alternate\" data-next-head=\"\"/><link href=\"https://careers.hybecorp.com/ko/o/234375\" hrefLang=\"x-default\" rel=\"alternate\" data-next-head=\"\"/><title data-next-head=\"\">[HYBE] 보건관리* (사업장/공연장 보건관리)</title><meta content=\"[HYBE] 보건관리* (사업장/공연장 보건관리)\" name=\"title\" data-next-head=\"\"/><meta content=\"HYBE Careers의 공고를 확인해 보세요.\" name=\"description\" data-next-head=\"\"/><meta 